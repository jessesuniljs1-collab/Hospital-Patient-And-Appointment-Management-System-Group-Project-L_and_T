{
  "name": "hospital-patient-and-appointment-management-system",
  "version": "1.0.0",
  "description": "Hospital patient and appointment management system built with Node.js, Express.js, MongoDB, and Mongoose.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js",
    "test": "node ./node_modules/jest/bin/jest.js --runInBand --forceExit --detectOpenHandles",
    "verify": "node scripts/verify-api.js"
  },
  "keywords": ["hospital", "patient", "appointment", "management", "express", "mongodb"],
  "dependencies": {
    "bcryptjs": "^2.4.3",
