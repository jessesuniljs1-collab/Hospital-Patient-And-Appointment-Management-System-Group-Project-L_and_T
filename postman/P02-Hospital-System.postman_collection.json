    {
      "name": "2. Departments",
      "item": [
        {
          "name": "List Departments (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set('departmentId', jsonData.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/departments"
          }
        },
        {
          "name": "Get Department by ID (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/departments/{{departmentId}}"
          }
        },
        {
          "name": "Create Department (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dermatology\",\n  \"description\": \"Skin care, allergy diagnostics, and dermatological procedures.\"\n}"
            },
            "url": "{{baseUrl}}/departments"
          }
        },
        {
          "name": "Create Department - 403 Forbidden (Patient Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403', function () { pm.response.to.have.status(403); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unauthorized Dept\",\n  \"description\": \"Should fail with 403\"\n}"
            },
            "url": "{{baseUrl}}/departments"
          }
        }
      ]
    },
    {
      "name": "3. Doctors & Availability",
      "item": [
        {
          "name": "List Doctors (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "if (jsonData.data && jsonData.data.doctors && jsonData.data.doctors.length > 0) {",
                  "    pm.collectionVariables.set('doctorId', jsonData.data.doctors[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/doctors"
          }
        },
        {
          "name": "Search Doctors by Specialization",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/doctors?specialization=Cardiology"
          }
        },
        {
          "name": "Search Doctors by Department",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/doctors?department=Neurology"
          }
        },
        {
          "name": "Get Doctor by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/doctors/{{doctorId}}"
          }
        },
        {
          "name": "Update Availability Slots (Doctor/Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availabilitySlots\": [\n    { \"day\": \"Monday\", \"startTime\": \"09:00\", \"endTime\": \"13:00\" },\n    { \"day\": \"Monday\", \"startTime\": \"14:00\", \"endTime\": \"17:00\" },\n    { \"day\": \"Wednesday\", \"startTime\": \"09:00\", \"endTime\": \"13:00\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/doctors/{{doctorId}}/slots"
          }
        },
        {
          "name": "Overlapping Availability - 409 Conflict",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () { pm.response.to.have.status(409); });",
                  "pm.test('ErrorCode is OVERLAPPING_SLOTS', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.errorCode).to.eql('OVERLAPPING_SLOTS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availabilitySlots\": [\n    { \"day\": \"Monday\", \"startTime\": \"09:00\", \"endTime\": \"12:00\" },\n    { \"day\": \"Monday\", \"startTime\": \"11:00\", \"endTime\": \"14:00\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/doctors/{{doctorId}}/slots"
          }
        }
      ]
    },
    {
      "name": "4. Appointments",
      "item": [
        {
          "name": "Book Appointment (Patient)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('appointmentId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"date\": \"2026-09-07\",\n  \"slot\": {\n    \"startTime\": \"11:00\",\n    \"endTime\": \"11:30\"\n  },\n  \"reason\": \"Routine cardiac consultation.\"\n}"
            },
            "url": "{{baseUrl}}/appointments"
          }
        },
        {
          "name": "Double Booking Conflict - 409 Conflict",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () { pm.response.to.have.status(409); });",
                  "pm.test('Error code is APPOINTMENT_CONFLICT', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.errorCode).to.eql('APPOINTMENT_CONFLICT');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patient2Token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"date\": \"2026-09-07\",\n  \"slot\": {\n    \"startTime\": \"11:15\",\n    \"endTime\": \"11:45\"\n  },\n  \"reason\": \"Trying to book overlapping time window with same doctor.\"\n}"
            },
            "url": "{{baseUrl}}/appointments"
          }
        },
        {
          "name": "Slot Outside Doctor Availability - 400 Bad Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('ErrorCode is SLOT_NOT_AVAILABLE', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.errorCode).to.eql('SLOT_NOT_AVAILABLE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"date\": \"2026-09-07\",\n  \"slot\": {\n    \"startTime\": \"03:00\",\n    \"endTime\": \"03:30\"\n  },\n  \"reason\": \"Invalid middle-of-night slot.\"\n}"
            },
            "url": "{{baseUrl}}/appointments"
          }
        },
        {
          "name": "List Appointments (Role Filtered)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/appointments"
          }
        },
        {
          "name": "Get Appointment by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}"
          }
        }
      ]
    },
    {
      "name": "5. Status Workflow",
      "item": [
        {
          "name": "Transition 1: Booked -> Confirmed (Doctor/Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Appointment is Confirmed', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.status).to.eql('Confirmed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Confirmed\",\n  \"notes\": \"Appointment approved by doctor.\"\n}"
            },
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/status"
          }
        },
        {
          "name": "Transition 2: Confirmed -> Completed (Doctor/Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status is Completed', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.status).to.eql('Completed');",
                  "    pm.collectionVariables.set('completedApptId', json.data._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\",\n  \"notes\": \"Patient visit and physical examination completed.\"\n}"
            },
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/status"
          }
        },
        {
          "name": "Invalid Transition - Completed -> Booked (400 Rejected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('ErrorCode is INVALID_STATUS_TRANSITION', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.errorCode).to.eql('INVALID_STATUS_TRANSITION');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Booked\"\n}"
            },
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/status"
          }
        },
        {
          "name": "Forbidden Transition - Patient tries to mark Completed (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 or 403', function () {",
                  "    pm.expect([400, 403]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\"\n}"
            },
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/status"
          }
        }
      ]
    },
    {
      "name": "6. Digital Prescriptions",
      "item": [
        {
          "name": "Issue Prescription for Completed Appt (Doctor Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('prescriptionId', jsonData.data._id);",
