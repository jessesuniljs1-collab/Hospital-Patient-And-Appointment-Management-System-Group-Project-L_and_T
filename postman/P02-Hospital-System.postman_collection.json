            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{completedApptId}}\",\n  \"medicines\": [\n    {\n      \"name\": \"Metoprolol\",\n      \"dosage\": \"25mg\",\n      \"frequency\": \"Once daily\",\n      \"duration\": \"14 days\",\n      \"instructions\": \"With food in morning\"\n    }\n  ],\n  \"diagnosis\": \"Mild sinus tachycardia\",\n  \"notes\": \"Reduce caffeine intake, monitor resting heart rate.\"\n}"
            },
            "url": "{{baseUrl}}/prescriptions"
